# openbook environment variables (copy to .env)

# Required in production
SECRET_KEY=change-me-in-production
# DATABASE_URL=postgres://user:pass@localhost:5432/openbook

# Development defaults
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Tashkent

# Production (uncomment and set)
# CSRF_TRUSTED_ORIGINS=https://books.javohirmx.com
# CORS_ALLOWED_ORIGINS=https://books.javohirmx.com

# Metadata API base URLs (optional overrides)
OPENLIBRARY_BASE_URL=https://openlibrary.org
GOOGLE_BOOKS_BASE_URL=https://www.googleapis.com/books/v1
# Contact email in User-Agent for Open Library 3 req/s rate limit (required for enrichment imports)
# OPENLIBRARY_CONTACT_EMAIL=you@example.com

# Import metadata pacing (0 = auto: 0.35s with contact email, 1s without)
# METADATA_IMPORT_DELAY_SECONDS=0.35
IMPORT_GOODREADS_ENRICH_METADATA=true
METADATA_WIKIDATA_ENABLED=true
# chain = Open Library first, then Google Books/Wikidata only when needed (default)
# parallel = legacy behavior (query all providers every time)
# METADATA_LOOKUP_STRATEGY=chain
METADATA_AUTO_APPLY_THRESHOLD=0.82
METADATA_REVIEW_GAP_THRESHOLD=0.08
# Optional API keys (off by default; improve coverage and rate limits)
# GOOGLE_BOOKS_API_KEY=
# HARDCOVER_API_TOKEN=
# METADATA_HARDCOVER_ENABLED=true
# ISBNDB_API_KEY=

# Import job processing (true = web app drains queue in a background thread; false = use worker container)
# IMPORT_JOB_STALE_MINUTES=30
# IMPORT_JOB_DEBUG_STALE_MINUTES=5
# IMPORT_JOB_CANCEL_FINALIZE_SECONDS=120
IMPORT_JOB_AUTO_PROCESS=true
# IMPORT_JOB_STALE_MINUTES=30

# API throttling (Phase 2+)
# API_THROTTLE_RATES=user=1000/day,auth=5/min

# Logging
LOG_LEVEL=INFO
