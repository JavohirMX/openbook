# openbook environment variables (copy to .env)

# Required in production
SECRET_KEY=change-me-in-production
# DATABASE_URL=postgres://user:pass@localhost:5432/openbook

# Development defaults
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Tashkent

# Production (uncomment and set)
# CSRF_TRUSTED_ORIGINS=https://books.javohirmx.com
# CORS_ALLOWED_ORIGINS=https://books.javohirmx.com

# Metadata API base URLs (optional overrides)
OPENLIBRARY_BASE_URL=https://openlibrary.org
GOOGLE_BOOKS_BASE_URL=https://www.googleapis.com/books/v1

# API throttling (Phase 2+)
# API_THROTTLE_RATES=user=1000/day,auth=5/min

# Logging
LOG_LEVEL=INFO
